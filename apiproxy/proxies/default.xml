<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>Verify-API-Key</Name>
            </Step>
            <Step>
                <Name>Quota</Name>
            </Step>
            <Step>
                <Name>KVM-client-creditional</Name>
            </Step>
            <Step>
                <Name>SC-Token-genration-App-specific</Name>
                <Condition>(developer.app.name = "Abhishek_SML")</Condition>
            </Step>
            <Step>
                <Name>Service-Callout-Token-genration</Name>
                <Condition>(developer.app.name != "Abhishek_SML")</Condition>
            </Step>
            <Step>
                <Name>EV-Extract-Access-Token</Name>
            </Step>
            <Step>
                <Name>AM-Set-Bearer-Token</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="Hello">
            <Description/>
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/user") and (request.verb = "GET")</Condition>
        </Flow>
        <Flow name="HEAD">
            <Description/>
            <Request/>
            <Response/>
            <Condition>(request.verb = "HEAD")</Condition>
        </Flow>
        <Flow name="OPTIONS">
            <Description/>
            <Request/>
            <Response/>
            <Condition>(request.verb = "OPTIONS")</Condition>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/sml-training-abhishek</BasePath>
        <Pathsuffix>/XML</Pathsuffix>
        <VirtualHost>hard_vhost</VirtualHost>
        <VirtualHost>https_vhostex</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>