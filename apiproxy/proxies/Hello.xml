<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="Hello">
    <Description/>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>Verify-API-Key</Name>
            </Step>
            <Step>
                <Name>Response-Cache</Name>
            </Step>
        </Request>
        <Response>
            <Step>
                <Name>XML-to-JSON</Name>
            </Step>
            <Step>
                <Name>JSON-to-XML</Name>
            </Step>
        </Response>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>EV-Extract-Response</Name>
            </Step>
            <Step>
                <Name>SC-POC-Metrics</Name>
            </Step>
        </Response>
    </PostFlow>
    <Flows>
        <Flow name="user details">
            <Description/>
            <Request/>
            <Response/>
            <Condition>(proxy.pathsuffix MatchesPath "/xml") and (request.verb = "GET")</Condition>
        </Flow>
    </Flows>
    <HTTPProxyConnection>
        <BasePath>/cache</BasePath>
        <Properties/>
        <VirtualHost>hard_vhost</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>